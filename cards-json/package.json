{
  "name": "@5argon/cards-db",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "merge-pack": "deno run --allow-read --allow-write ./scripts/pack.ts",
    "set-partial": "deno run --allow-read --allow-write ./scripts/set-partial.ts",
    "download": "deno run --allow-read --allow-write --allow-net ./scripts/download.ts",
    "patch-cards": "deno run --allow-read --allow-write --allow-net ./scripts/patch.ts",
    "process": "deno run --allow-read --allow-write --allow-net ./scripts/process.ts",
    "sync": "deno run --allow-read --allow-write --allow-run=rclone ./scripts/rclone-sync.ts",
    "copy-cards": "deno run --allow-read --allow-write ./scripts/copy-cards.ts"
  }
}
