{
  "name": "@5argon/arkham-tsk-solver",
  "version": "0.0.1",
  "type": "module",
  "description": "Framework-agnostic solver for optimal campaign routes in Arkham Horror LCG: The Scarlet Keys.",
  "scripts": {
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "copy-data": "node -e \"const fs=require('fs');fs.mkdirSync('dist/data/new',{recursive:true});fs.copyFileSync('src/data/new/logic.json','dist/data/new/logic.json');fs.copyFileSync('src/data/new/en.json','dist/data/new/en.json')\"",
    "build": "tsc -b && npm run copy-data",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json}\"",
    "prepare": "npm run paraglide && npm run build"
  },
  "dependencies": {
    "@inlang/paraglide-js": "2.29.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ]
}
