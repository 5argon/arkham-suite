{
	"name": "@5argon/arkham-life-ui",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"paraglide-compile": "npx @inlang/paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide"
	},
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./src/lib/index.ts",
	"types": "./src/lib/index.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/lib/index.ts",
			"svelte": "./src/lib/index.ts",
			"default": "./src/lib/index.ts"
		},
		"./markdown": "./src/lib/card/markdown-processor.ts"
	},
	"main": "./src/lib/index.ts",
	"peerDependencies": {
		"@5argon/arkham-kohaku": "workspace:*",
		"svelte": "^5.49.2"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/aspect-ratio": "^0.4.2",
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/dompurify": "^3.2.0",
		"@types/eslint": "^9.6.1",
		"@types/qrcode": "^1.5.6",
		"autoprefixer": "^10.6.2",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"mdsvex": "^0.12.8",
		"postcss": "^8.5.32",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"svelte-marked": "^0.8.0",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"@5argon/arkham-icon": "workspace:*",
		"@5argon/arkham-string": "workspace:*",
		"@floating-ui/dom": "^1.8.0",
		"@inlang/paraglide-js": "^2.29.3",
		"@types/color": "^4.2.1",
		"clsx": "^2.1.1",
		"color": "^5.0.3",
		"dompurify": "^3.4.17",
		"fuse.js": "^7.5.0",
		"marked": "^18.1.2",
		"qrcode": "^1.5.4"
	}
}
