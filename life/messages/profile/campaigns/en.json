				"countPlural=one": "{count} play",
				"countPlural=other": "{count} plays"
			}
		}
	],
	"campaigns_trauma_empty": "No deadly or maddening endings recorded yet — pick the resolution you reached in a scenario's Extra tab, and any ending that kills or drives your party insane will tally here.",
