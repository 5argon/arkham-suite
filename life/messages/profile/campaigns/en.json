{
	"$schema": "https://inlang.com/schema/inlang-message-format",
	"campaigns_index_page_title": "Campaigns – arkham.life",
	"campaigns_index_played_heading": "Campaigns played ({count})",
	"campaigns_index_empty": "No campaigns recorded yet.",
	"campaigns_plays": [
		{
			"declarations": ["input count", "local countPlural = count: plural"],
			"selectors": ["countPlural"],
