{
	"name": "@5argon/arkham-life",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"deploy": "vite build && yarn wrangler deploy",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --ignore-path .gitignore --check . && eslint --ignore-path .gitignore .",
		"format": "prettier --ignore-path .gitignore --write .",
		"test": "vitest",
		"test:e2e": "playwright test",
		"docs:sync": "node scripts/sync-doc-images.mjs",
		"paraglide-compile": "npx @inlang/paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/eslint": "^9.6.1",
		"@types/pako": "^3.0.0",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"mdsvex": "^0.12.8",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"svelte-preprocess": "^6.0.5",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"wrangler": "^4.155.0"
	},
	"dependencies": {
		"@5argon/arkham-campaign-data": "workspace:*",
		"@5argon/arkham-kohaku": "workspace:*",
		"@5argon/arkham-life-ui": "workspace:*",
		"@5argon/arkham-string": "workspace:*",
		"@5argon/arkham-tsk-solver": "workspace:*",
		"@inlang/paraglide-js": "^2.29.3",
		"fflate": "^0.8.3",
		"pako": "^3.0.3"
	}
}
