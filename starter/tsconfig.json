{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"lib": ["es2022", "DOM"],
		"moduleResolution": "bundler",
		"module": "esnext",
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"verbatimModuleSyntax": true,
		"target": "es2020",
		"composite": true,
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": true,
		"outDir": "./dist"
	},
	"references": [
		{
			"path": "../kohaku"
		},
		{
			"path": "../campaign-data"
		},
		{
			"path": "../string"
		}
	],
	"include": ["src/**/*.js", "src/**/*.ts", "src/**/*.svelte", "src/**/*.json"]
}
