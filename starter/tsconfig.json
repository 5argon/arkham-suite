{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"lib": ["es2022", "DOM"],
		"moduleResolution": "node",
		"module": "es2020",
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"target": "es2020",
		"composite": true,
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": true,
		"outDir": "./dist"
	},
	"references": [
		{
			"path": "../kohaku"
		},
		{
			"path": "../campaign-data"
		},
		{
			"path": "../string"
		}
	],
	// TypeScript does not merge `include` with the extended config, so the two
	// generated declaration files that `./.svelte-kit/tsconfig.json` includes have
	// to be repeated here. Without them `$env/static/*`, `$app/*` and the
	// per-route `./$types` modules do not resolve.
	"include": [
		".svelte-kit/ambient.d.ts",
		".svelte-kit/non-ambient.d.ts",
		".svelte-kit/types/**/$types.d.ts",
		"src/**/*.js",
		"src/**/*.ts",
		"src/**/*.svelte",
		"src/**/*.json"
	]
}
