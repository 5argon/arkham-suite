{
	"name": "@5argon/arkham-starter",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build-ui": "yarn workspace @5argon/arkham-ui build",
		"story": "deno run --allow-read --allow-write https://deno.land/x/sveltekit_stories_watcher@0.0.2/mod.ts ./src/lib/design ./src/routes/storybook",
		"build": "vite build",
		"deploy": "vite build && yarn wrangler deploy",
		"package": "vite package",
		"preview": "vite preview",
		"prepare": "vite sync",
		"test": "vitest",
		"deck-process": "deno run --allow-read --allow-write --allow-net ./deno/deck-process.ts ./src/lib/data/decks.csv",
		"download-cards": "tsx scripts/download-cards.ts",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --ignore-path .gitignore --check --plugin-search-dir=. . && eslint --ignore-path .gitignore .",
		"format": "prettier --ignore-path .gitignore --write --plugin-search-dir=. .",
		"proto": "npx protoc --ts_out ./src/lib/proto/generated --proto_path ./src/lib/proto/definitions  ./src/lib/proto/definitions/*",
		"paraglide-compile": "npx @inlang/paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"screenshot:setup": "tsx scripts/screenshot-setup-cards.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/eslint": "^9.6.1",
		"@types/pako": "^3.0.0",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"autoprefixer": "^10.6.2",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-svelte": "^3.23.1",
		"jsdom": "^30.1.3",
		"postcss": "^8.5.32",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"svelte-marked": "^0.8.0",
		"svelte-preprocess": "^6.0.5",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"wrangler": "^4.155.0"
	},
	"type": "module",
	"dependencies": {
		"@5argon/arkham-campaign-data": "workspace:*",
		"@5argon/arkham-icon": "workspace:*",
		"@5argon/arkham-kohaku": "workspace:*",
		"@5argon/arkham-life-ui": "workspace:*",
		"@5argon/arkham-string": "workspace:*",
		"@5argon/arkham-tags": "workspace:*",
		"@5argon/arkham-tsk-solver": "workspace:*",
		"@fontsource/fira-mono": "^5.3.0",
		"@inlang/paraglide-js": "^2.29.3",
		"@lukeed/uuid": "^2.0.1",
		"@protobuf-ts/plugin": "^2.11.1",
		"@protobuf-ts/runtime": "^2.11.1",
		"clsx": "^2.1.1",
		"cookie": "^2.0.1",
		"fuse.js": "^7.5.0",
		"pako": "^3.0.3"
	}
}
