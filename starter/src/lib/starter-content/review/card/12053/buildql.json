{
	"presets": [
		{
			"label": "Tests [agility]",
			"query": "text = \"([agility]\" | text = \"[agility])\" | text == \"test [agility]\""
		},
		{
			"label": "Tests [agility], not Evade",
			"query": "(text = \"([agility]\" | text = \"[agility])\" | text == \"test [agility]\") & text !== \"<b>evade\""
		},
		{
			"label": "Succeed By",
			"query": "(text = \"succeed by\" | text = \"successful by\") & text != \"succeed by 0\""
		},
		{
			"label": "Raise success",
			"query": "(text = \"after revealing chaos tokens\" | text = \"would succeed at a skill test\") & text = \"you get skill value\""
		}
	]
}
