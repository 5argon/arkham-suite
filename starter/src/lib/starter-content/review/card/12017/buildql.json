		},
		{
			"label": "Fight / Evade +2 [combat] / [agility]",
			"query": "text = \"<b>fight</b> [combat]\" | text = \"<b>fight</b> [agility]\" | text = \"<b>evade</b> [combat]\" | text = \"<b>evade</b> [agility]\""
		}
	]
}
