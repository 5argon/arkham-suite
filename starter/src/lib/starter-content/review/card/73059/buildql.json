{
	"presets": [
		"insight-event",
		"tactic-event",
		"trick-event",
		{
			"label": "[[Insight]] / [[Tactic]] / [[Trick]] event",
			"query": "type == \"event\" & tr ?? [\"insight\", \"tactic\", \"trick\"]"
		},
		{
			"label": "Event with 2 of [[Insight]] / [[Tactic]] / [[Trick]]",
			"query": "type == \"event\" & ((tr == \"insight\" & tr == \"tactic\") | (tr == \"insight\" & tr == \"trick\") | (tr == \"tactic\" & tr == \"trick\"))"
		}
	]
}
