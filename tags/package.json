    "./cards.json": "./json/export/cards.json"
  },
  "files": [
    "dist",
    "json/export/cards.json"
  ],
  "dependencies": {
    "@5argon/arkham-kohaku": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3"
  }
