{
  "name": "@5argon/arkham-tags",
  "type": "module",
  "scripts": {
    "sync-unions": "node ./script/generate-unions.ts",
    "seed-strings": "node ./script/seed-strings.ts",
    "build-strings": "node ./script/build-strings.ts",
    "export-json": "node ./script/export-json.ts",
    "digest": "node ./script/build-digest.ts",
    "precedent": "node ./script/find-precedent.ts",
    "lint-tags": "node ./script/lint-tags.ts",
    "build": "tsc -b && node ./script/export-json.ts",
    "scaffold-untagged": "node ./script/scaffold-untagged.ts",
    "sync-worklists": "node ./script/sync-worklists.ts"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
