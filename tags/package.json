{
  "name": "@5argon/arkham-tags",
  "type": "module",
  "scripts": {
    "sync-unions": "deno run --allow-read --allow-write ./script/generate-unions.ts",
    "seed-strings": "node ./script/seed-strings.ts",
    "build-strings": "node ./script/build-strings.ts",
    "export-json": "node ./script/export-json.ts",
    "digest": "node ./script/build-digest.ts",
    "build": "tsc -b",
    "scaffold-untagged": "node ./script/scaffold-untagged.ts"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cards.json": "./json/export/cards.json"
  },
  "files": [
    "dist",
    "json/export/cards.json"
  ],
  "dependencies": {
    "@5argon/arkham-kohaku": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  }
}
